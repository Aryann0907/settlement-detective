# ==============================================================================
# Settlement Detective — Environment Configuration Template
# Copy this file to .env and provide your credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Razorpay Test Mode API Credentials (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret

# Razorpay Webhook Secret (Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI Provider Configuration ('gemini' or 'mock')
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
